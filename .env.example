# MongoDB – local or Atlas URI
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=civicsense

# JWT
JWT_SECRET=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# HuggingFace Inference API (free tier works)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# FastAPI backend URL (used by Streamlit frontend)
API_BASE_URL=http://localhost:8000

# Streamlit frontend URL used in password-reset emails
FRONTEND_BASE_URL=http://localhost:8501

# SMTP configuration (Gmail requires an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=30

# Upload limits
MAX_IMAGE_SIZE_MB=5
